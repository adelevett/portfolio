---
layout: base.njk
title: Professional Development Log
---

<section class="hero-banner">
  <div class="hero-inner">
    <p class="hero-eyebrow mono">Follow the work</p>
    <h1 class="hero-title">Professional<br><em>Development</em><br>Log</h1>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">{{ engagements | length }}</span>
        <span class="stat-label">engagements</span>
      </div>
      <div class="stat-divider">◈</div>
      <div class="stat">
        <span class="stat-num">{{ engagements | length }}</span>
        <span class="stat-label">talks &amp; workshops</span>
      </div>
    </div>
  </div>
</section>

<section class="timeline-section">
  {% set grouped = engagements | groupByYearTerm %}
  {% for year, terms in grouped %}
    <div class="year-group">
      <div class="year-label">
        <span class="mono year-num">{{ year }}</span>
        <div class="year-line"></div>
      </div>

      {% for term, items in terms %}
        <div class="term-group">
          <h2 class="term-heading mono">{{ term }}</h2>

          <div class="timeline">
            <div class="timeline-spine"></div>
            {% for e in items %}
              {%- set side = "left" if loop.index0 % 2 == 0 else "right" -%}
              <div class="timeline-row timeline-row--{{ side }}">

                <a href="{{ ('/' + e.slug + '/') | url }}" class="timeline-card">
                  <div class="tcard-image">
                    {% if e.thumb %}
                      <img src="{{ (e | assetUrl(e.thumb)) | url }}" alt="{{ e.title }}" loading="lazy">
                    {% else %}
                      <div class="tcard-image-placeholder mono">{{ e.venue }}</div>
                    {% endif %}
                    <div class="tcard-location mono">
                      <span class="badge-dot"></span>{{ e.location }}
                    </div>
                  </div>
                  <div class="tcard-body">
                    <p class="tcard-event mono">{{ e.event }}</p>
                    <h3 class="tcard-title">{{ e.title }}</h3>
                  </div>
                </a>

                <div class="timeline-dot-col">
                  <div class="timeline-dot"></div>
                  <div class="tcard-date-badge mono">
                    <span class="date-icon">◷</span>{{ e.date | niceDate }}
                  </div>
                </div>

                <div class="timeline-spacer"></div>
              </div>
            {% endfor %}
          </div>

        </div>
      {% endfor %}
    </div>
  {% endfor %}
</section>
