---
layout: base.njk
title: Home
description: Portfolio of Alexis Delevett, Adapted Technology Specialist at College of San Mateo.
---

<section class="welcome-section" id="welcome" aria-labelledby="welcome-title">
  <div class="welcome-inner">
    <div class="welcome-copy">
      <h1 id="welcome-title">Alexis Delevett</h1>
      <p class="hero-intro">Welcome. Thank you for visiting my portfolio. I'm the Adapted Technology Specialist at the College of San Mateo Disability Resource Center, and I'm glad to share my work with you.</p>
    </div>
    <video class="welcome-video" controls preload="metadata" playsinline>
      <source src="{{ '/img/welcome.mp4' | url }}" type="video/mp4">
      <track kind="captions" src="{{ '/img/welcome.vtt' | url }}" srclang="en" label="English" default>
    </video>
  </div>
</section>

<section class="work-section" id="sections" aria-labelledby="sections-title">
  <h2 id="sections-title" class="visually-hidden">Sections</h2>
  <div class="area-grid">
    {% for item in nav %}{% if item.section %}
      {% set itemUrl = item.url or ('/' + item.section + '/') %}
      {% set pages = collections.sectionPages[item.section] %}
      {% set landingDescription = '' %}
      {% for p in pages %}{% if p.url == itemUrl %}{% set landingDescription = p.data.description %}{% endif %}{% endfor %}
      {% if not landingDescription and item.blurb %}{% set landingDescription = item.blurb %}{% endif %}
      <a href="{{ itemUrl | url }}" class="area-card">
        <h3>{{ item.title }}</h3>
        {% if landingDescription %}<p>{{ landingDescription }}</p>{% endif %}
      </a>
    {% endif %}{% endfor %}
  </div>
</section>