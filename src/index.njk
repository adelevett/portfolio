---
layout: base.njk
title: Events Log
---

<section class="hero-banner">
  <div class="hero-inner">
    <p class="hero-eyebrow mono">Event log</p>
    <h1 class="hero-title">Campus & Community Outreach</h1>
    <p class="hero-lead">A record of sessions organized by term and year.</p>
    <div class="hero-actions">
      <a href="#timeline" class="hero-jump mono">Jump to timeline</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">{{ engagements | length }}</span>
        <span class="stat-label">events logged</span>
      </div>
    </div>
  </div>
</section>

<section class="timeline-section" id="timeline" aria-label="Event timeline">
  {% set grouped = engagements | groupByYearTerm %}
  {% for yearGroup in grouped %}
    <div class="year-group">
      <div class="year-label">
        <span class="mono year-num">{{ yearGroup.year }}</span>
        <div class="year-line"></div>
      </div>

      {% for termGroup in yearGroup.terms %}
        <div class="term-group">
          <h2 class="term-heading mono">{{ termGroup.name }}</h2>

          <div class="timeline">
            <div class="timeline-spine"></div>
            {% for e in termGroup.items %}
              {%- set side = "left" if e.globalIndex % 2 == 0 else "right" -%}
              <div class="timeline-row timeline-row--{{ side }}">

                <a href="{{ ('/' + e.slug + '/') | url }}" class="timeline-card">
                  <div class="tcard-image">
                    {% if e.thumb %}
                      <img src="{{ (e | assetUrl(e.thumb)) | url }}" alt="{{ e.title }}" loading="lazy">
                    {% else %}
                      <div class="tcard-image-placeholder mono">{{ e.venue }}</div>
                    {% endif %}
                    <div class="tcard-location mono">
                      <span class="badge-dot"></span>{{ e.location }}
                    </div>
                  </div>
                  <div class="tcard-body">
                    <div class="tcard-meta">
                      <p class="tcard-event mono">{{ e.event }}</p>
                      <p class="tcard-date mono">
                        <span class="date-icon" aria-hidden="true">◷</span>
                        <span>{{ e.date | niceDate }}</span>
                      </p>
                    </div>
                    <h3 class="tcard-title">{{ e.title }}</h3>
                  </div>
                </a>

                <div class="timeline-dot-col">
                  <div class="timeline-dot"></div>
                </div>

                <div class="timeline-blurb">
                  <p>{{ e.blurb }}</p>
                </div>
              </div>
            {% endfor %}
          </div>

        </div>
      {% endfor %}
    </div>
  {% endfor %}
</section>
