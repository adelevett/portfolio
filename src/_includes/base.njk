<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Professional Development" }} — Portfolio</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a href="{{ '/' | url }}" class="site-nav-link{% if page.url == '/' %} is-current{% endif %}"{% if page.url == '/' %} aria-current="page"{% endif %}>Portfolio</a>
      <span class="site-nav-divider" aria-hidden="true">|</span>
      <a href="{{ '/about/' | url }}" class="site-nav-link{% if page.url == '/about/' %} is-current{% endif %}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
    </nav>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <span class="mono">Built with Typst + Eleventy</span>
  </footer>
</body>
</html>
